wikiddle.com {
    tls /etc/caddy/wikiddle.pem /etc/caddy/wikiddle.key
	header Content-Security-Policy "default-src 'self'; script-src 'self' cdn.jsdelivr.net; style-src 'self' cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'"
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle {
        root * /var/www/wikiddle/frontend
        try_files {path} /index.html
        file_server
    }
}
:80 {
	header Content-Security-Policy "default-src 'self'; script-src 'self' cdn.jsdelivr.net; style-src 'self' cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'"
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle {
        root * /var/www/wikiddle/frontend
        try_files {path} /index.html
        file_server
    }
}
