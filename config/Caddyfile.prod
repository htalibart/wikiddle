wikiddle.com {
    tls /etc/caddy/wikiddle.pem /etc/caddy/wikiddle.key
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle /fr* {
        rewrite * /index.html
        file_server {
            root * /var/www/wikiddle/frontend
        }
    }
    handle /en* {
        rewrite * /index.html
        file_server {
            root * /var/www/wikiddle/frontend
        }
    }
    handle {
        root * /var/www/wikiddle/frontend
        file_server
    }
}

:80 {
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle /fr* {
        rewrite * /index.html
        file_server {
            root * /var/www/wikiddle/frontend
        }
    }
    handle /en* {
        rewrite * /index.html
        file_server {
            root * /var/www/wikiddle/frontend
        }
    }
    handle {
        root * /var/www/wikiddle/frontend
        file_server
    }
}
