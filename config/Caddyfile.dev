:8080 {
	header Content-Security-Policy "default-src 'self'; script-src 'self' cdn.jsdelivr.net; style-src 'self' cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:"
	header X-Content-Type-Options "nosniff"
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle {
        root * frontend
        try_files {path} /index.html
        file_server
    }
}
