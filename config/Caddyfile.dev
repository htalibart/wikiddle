:8080 {
    # Restrict sources for scripts, styles, etc. to same origin and jsdelivr CDN
    header Content-Security-Policy "default-src 'self'; script-src 'self' cdn.jsdelivr.net; style-src 'self' cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:"
    # Prevent MIME type sniffing
    header X-Content-Type-Options "nosniff"

    # API — proxied to FastAPI
    handle /api/* {
        reverse_proxy localhost:8000
    }

    # index.html — entry point, never cache
    handle /index.html {
        header Cache-Control "no-cache"
        root * frontend/dist
        file_server
    }

    # Translation files — always revalidate with server
    handle /i18n/* {
        header Cache-Control "no-cache"
        root * frontend/dist
        file_server
    }

    # Everything else — static files (JS, CSS, images)
    handle {
        root * frontend/dist
        try_files {path} /index.html
        file_server
    }
}
